# --- Supabase (optional for local dev) ---
# With these blank, Kitabu runs as the demo: everything stays in this browser,
# and sign-in accepts any phone number with the setup code KTAB-2468.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Only on your own computer: never in the app, GitHub or a host ---
# Session-pooler connection string, for `npm run db:migrate`.
DATABASE_URL=
# Service-role key, for `npm run operator` (making your operator login).
SUPABASE_SERVICE_ROLE_KEY=

# --- The app ---
# Your WhatsApp number for the "contact us" buttons. Blank: the buttons are hidden.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Set when the app is served from a sub-folder, e.g. /Kitabu-ERP on GitHub Pages.
NEXT_PUBLIC_BASE_PATH=
# The public address, for link previews (e.g. https://nathankagoro.github.io/Kitabu-ERP).
NEXT_PUBLIC_SITE_URL=

# --- Error tracking (optional) ---
# The "Loader Script" URL from Sentry > Project Settings > Client Keys > Loader Script.
NEXT_PUBLIC_SENTRY_LOADER_URL=
