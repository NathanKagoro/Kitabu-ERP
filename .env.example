# --- Supabase (optional for local dev) ---
# With these blank, Hesabu runs fully local: Dexie is the store, auth is
# simulated, OTP is 123456. Nothing is lost -- sync starts once you fill these in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by drizzle-kit migrations and server actions.
DATABASE_URL=

# --- Dev switches ---
# 1 = accept the fixed OTP 123456 without sending an SMS.
NEXT_PUBLIC_DEV_OTP=1

# --- Error tracking (optional) ---
# The "Loader Script" URL from Sentry > Project Settings > Client Keys > Loader Script.
# Loads the SDK only when an error happens, so it costs no bandwidth otherwise.
NEXT_PUBLIC_SENTRY_LOADER_URL=
